import torch
import torch.nn as nn
import torch.nn.functional as F


class BoundaryAwareAttention(nn.Module):
    """Boundary-Aware Attention mechanism for segmentation."""
    
    def __init__(self, in_channels: int):
        super().__init__()
        self.in_channels = in_channels
        self.query = nn.Conv2d(in_channels, in_channels // 8, 1)
        self.key = nn.Conv2d(in_channels, in_channels // 8, 1)
        self.value = nn.Conv2d(in_channels, in_channels, 1)
        self.gamma = nn.Parameter(torch.zeros(1))
        
    def forward(self, x: torch.Tensor) -> torch.Tensor:
        batch_size, channels, height, width = x.size()
        
        # Compute attention maps
        q = self.query(x).view(batch_size, -1, height * width).permute(0, 2, 1)
        k = self.key(x).view(batch_size, -1, height * width)
        v = self.value(x).view(batch_size, -1, height * width)
        
        # Attention weights
        attention = torch.bmm(q, k)
        attention = F.softmax(attention / (self.in_channels ** 0.5), dim=-1)
        
        # Apply attention
        out = torch.bmm(v, attention.permute(0, 2, 1))
        out = out.view(batch_size, channels, height, width)
        
        # Residual connection with learnable weight
        return x + self.gamma * out


class TransformerBlock(nn.Module):
    """Transformer block with multi-head attention for bottleneck."""
    
    def __init__(self, in_channels: int, num_heads: int = 4):
        super().__init__()
        self.norm1 = nn.GroupNorm(32, in_channels)
        self.attention = BoundaryAwareAttention(in_channels)
        self.norm2 = nn.GroupNorm(32, in_channels)
        self.mlp = nn.Sequential(
            nn.Conv2d(in_channels, in_channels * 4, 1),
            nn.GELU(),
            nn.Conv2d(in_channels * 4, in_channels, 1)
        )
        
    def forward(self, x: torch.Tensor) -> torch.Tensor:
        # Self-attention with residual
        x = x + self.attention(self.norm1(x))
        # MLP with residual
        x = x + self.mlp(self.norm2(x))
        return x


class ConvBlock(nn.Module):
    """Double convolution block with batch normalization."""
    
    def __init__(self, in_channels: int, out_channels: int):
        super().__init__()
        self.conv = nn.Sequential(
            nn.Conv2d(in_channels, out_channels, 3, padding=1),
            nn.BatchNorm2d(out_channels),
            nn.ReLU(inplace=True),
            nn.Conv2d(out_channels, out_channels, 3, padding=1),
            nn.BatchNorm2d(out_channels),
            nn.ReLU(inplace=True)
        )
        
    def forward(self, x: torch.Tensor) -> torch.Tensor:
        return self.conv(x)


class HybridUNet(nn.Module):
    """
    HybridUNet: UNet with Transformer bottleneck and Boundary-Aware Attention.
    
    Input: (B, 1, 256, 256) - Single channel grayscale CT slice
    Output: (B, 3, 256, 256) - 3-class segmentation mask
    Classes: 0=Background, 1=Kidney, 2=Tumor
    """
    
    def __init__(self, in_channels: int = 1, out_channels: int = 3, 
                 base_channels: int = 32):
        super().__init__()
        self.in_channels = in_channels
        self.out_channels = out_channels
        self.base_channels = base_channels
        
        # Encoder
        self.enc1 = ConvBlock(in_channels, base_channels)
        self.pool1 = nn.MaxPool2d(2, 2)
        
        self.enc2 = ConvBlock(base_channels, base_channels * 2)
        self.pool2 = nn.MaxPool2d(2, 2)
        
        self.enc3 = ConvBlock(base_channels * 2, base_channels * 4)
        self.pool3 = nn.MaxPool2d(2, 2)
        
        self.enc4 = ConvBlock(base_channels * 4, base_channels * 8)
        self.pool4 = nn.MaxPool2d(2, 2)
        
        # Bottleneck with Transformer
        self.bottleneck = TransformerBlock(base_channels * 8)
        
        # Decoder
        self.upconv4 = nn.ConvTranspose2d(base_channels * 8, base_channels * 4, 2, 2)
        self.dec4 = ConvBlock(base_channels * 4 + base_channels * 8, base_channels * 4)
        
        self.upconv3 = nn.ConvTranspose2d(base_channels * 4, base_channels * 2, 2, 2)
        self.dec3 = ConvBlock(base_channels * 2 + base_channels * 4, base_channels * 2)
        
        self.upconv2 = nn.ConvTranspose2d(base_channels * 2, base_channels, 2, 2)
        self.dec2 = ConvBlock(base_channels + base_channels * 2, base_channels)
        
        self.upconv1 = nn.ConvTranspose2d(base_channels, base_channels, 2, 2)
        self.dec1 = ConvBlock(base_channels + base_channels, base_channels)
        
        # Final output layer
        self.final = nn.Conv2d(base_channels, out_channels, 1)
        
    def forward(self, x: torch.Tensor) -> torch.Tensor:
        # Encoder with skip connections
        e1 = self.enc1(x)
        x = self.pool1(e1)
        
        e2 = self.enc2(x)
        x = self.pool2(e2)
        
        e3 = self.enc3(x)
        x = self.pool3(e3)
        
        e4 = self.enc4(x)
        x = self.pool4(e4)
        
        # Bottleneck
        x = self.bottleneck(x)
        
        # Decoder with skip connections
        x = self.upconv4(x)
        x = torch.cat([x, e4], dim=1)
        x = self.dec4(x)
        
        x = self.upconv3(x)
        x = torch.cat([x, e3], dim=1)
        x = self.dec3(x)
        
        x = self.upconv2(x)
        x = torch.cat([x, e2], dim=1)
        x = self.dec2(x)
        
        x = self.upconv1(x)
        x = torch.cat([x, e1], dim=1)
        x = self.dec1(x)
        
        # Output segmentation mask
        x = self.final(x)
        return x
    
    def load_from_checkpoint(self, checkpoint_path: str, device: str = 'cpu'):
        """Load model weights from checkpoint file."""
        try:
            # Try loading with weights_only=True first (safer)
            state_dict = torch.load(checkpoint_path, map_location=device, weights_only=True)
        except Exception as e:
            print(f"Warning: Failed to load with weights_only=True: {e}")
            print("Retrying with weights_only=False...")
            # Fallback to loading with weights_only=False
            state_dict = torch.load(checkpoint_path, map_location=device, weights_only=False)
        
        self.load_state_dict(state_dict)
        self.to(device)
        self.eval()
        
    def get_activation_maps(self, x: torch.Tensor) -> dict:
        """Get intermediate activation maps for visualization."""
        activations = {}
        
        # Encoder
        e1 = self.enc1(x)
        activations['enc1'] = e1.detach()
        x = self.pool1(e1)
        
        e2 = self.enc2(x)
        activations['enc2'] = e2.detach()
        x = self.pool2(e2)
        
        e3 = self.enc3(x)
        activations['enc3'] = e3.detach()
        x = self.pool3(e3)
        
        e4 = self.enc4(x)
        activations['enc4'] = e4.detach()
        x = self.pool4(e4)
        
        # Bottleneck
        x = self.bottleneck(x)
        activations['bottleneck'] = x.detach()
        
        return activations
